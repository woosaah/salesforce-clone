{
  "name": "salesforce-clone-backend",
  "version": "1.0.0",
  "description": "Multi-tenant CRM backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp/server.js",
    "migrate": "node dist/database/migrate.js",
    "seed": "node dist/database/seed.js",
    "seed:invoices": "node dist/database/seed-invoices.js",
    "seed:assets": "node dist/database/seed-assets.js",
    "seed:sales": "node dist/database/seed-sales.js",
    "seed:service": "node dist/database/seed-service.js",
    "seed:automation": "node dist/database/seed-automation.js",
    "seed:queries": "node dist/database/seed-queries.js",
    "seed:reports": "node dist/database/seed-reports.js",
    "seed:inventory": "node dist/database/seed-inventory.js",
    "seed:marketing": "node dist/database/seed-marketing.js",
    "seed:all": "npm run seed && npm run seed:sales && npm run seed:service && npm run seed:automation && npm run seed:queries && npm run seed:reports && npm run seed:inventory && npm run seed:marketing",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
